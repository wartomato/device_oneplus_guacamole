prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    ramdisk_available: true,
}

prebuilt_etc {
    name: "init.aicp-sm8150.rc",
    src: "init.aicp-sm8150.rc",
    sub_dir: "init/hw",
    vendor: true,
}

cc_library_static {
    name: "libinit_guacamole",
    srcs: ["init_guacamole.cpp"],
    recovery_available: true,
    include_dirs: ["system/libbase/include","system/core/init"],
    shared_libs: ["libbase"]
}