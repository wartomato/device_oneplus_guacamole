# Bluetooth
bluetooth.device.default_name=OnePlus 7 Pro

# Init (Android project name autogenerated by vendor_buildinfo.sh as a system.prop)
ro.boot.project_name=18821
ro.vendor.boot.project_name=18821

# OP-common build properties
ro.product.vendor.device=OnePlus7Pro
ro.product.vendor.brand=OnePlus
ro.product.vendor.manufacturer=OnePlus

# ADDITIONAL VENDOR BUILD PROPERTIES
persist.sys.oem.region=OverSeas
persist.sys.oem_smooth=1
ro.vendor.build.real.device=true

# VENDOR BUILD PROPERTIES
ro.product.cuptsm=ONEPLUS|ESE|01|02|80T
vendor.product.device=guacamole
vendor.product.manufacturer=OPD
vendor.usb.product_string=OnePlus7Pro
